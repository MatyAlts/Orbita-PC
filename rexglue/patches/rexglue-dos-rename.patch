+
+REX_TEST_CASE("files: NtOpenFile separates share access from open options",
+              "[kernel][files][orbita-rename]") {
+  KernelFixture fixture([](const std::filesystem::path& root) {
+    WriteScratch(root, "staged.bin", 16);
+    std::filesystem::create_directory(root / "scratch" / "folder");
+  });
+  MountScratch(fixture);
+  fixture.RunOnGuestThread([](Caller& c) {
+    const u32 handle_ptr = c.Alloc(4);
+    const u32 status = c.Alloc(8);
+    const u32 attrs = c.AllocAttributes("scratch:\\staged.bin");
+    REQUIRE(c.Kernel("NtOpenFile", {handle_ptr, 0x00110000, attrs, status, 7, 0x4020}) == 0);
+    CHECK(c.Kernel("NtClose", {c.Load32(handle_ptr)}) == 0);
+    const u32 folder_attrs = c.AllocAttributes("scratch:\\folder");
+    CHECK(c.Kernel("NtOpenFile", {handle_ptr, kReadWriteAccess, folder_attrs, status, 0, 0x40}) ==
+          rex::kernel::X_STATUS_FILE_IS_A_DIRECTORY);
+  });
+}
+
+REX_TEST_CASE("files: rename accepts the DOS devices root and prefix",
+              "[kernel][files][orbita-rename]") {
+  KernelFixture fixture([](const std::filesystem::path& root) {
+    WriteScratch(root, "staged.bin", 16);
+  });
+  MountScratch(fixture);
+  fixture.RunOnGuestThread([](Caller& c) {
+    const u32 handle_ptr = c.Alloc(4);
+    const u32 status = c.Alloc(8);
+    REQUIRE(c.Kernel("NtCreateFile", {handle_ptr, kReadWriteAccess,
+                                      c.AllocAttributes("scratch:\\staged.bin"), status,
+                                      0, 0, 3, 1, 0x20}) == 0);
+    const u32 handle = c.Load32(handle_ptr);
+    const u32 info = c.Alloc(16);
+    const auto rename = [&](std::string_view target, u32 root) {
+      c.Store32(info, 0);
+      c.Store32(info + 4, root);
+      c.Store32(info + 8, static_cast<u32>(target.size() << 16 | target.size()));
+      c.Store32(info + 12, c.AllocString(target));
+      return c.Kernel("NtSetInformationFile",
+                      {handle, status, info, 16, rex::kernel::XFileRenameInformation});
+    };
+    CHECK(rename("scratch:\\intermediate.bin", 0xFFFFFFFD) == 0);
+    CHECK(rename("\\??\\scratch:\\finished.bin", 0xFFFFFFFD) == 0);
+    CHECK(rename("scratch:\\unreachable.bin", 0xFFFFFFFC) ==
+          rex::kernel::X_STATUS_INVALID_HANDLE);
+    CHECK(c.Kernel("NtClose", {handle}) == 0);
+  });
+  CHECK_FALSE(std::filesystem::exists(fixture.GetRoot() / "scratch" / "staged.bin"));
+  CHECK(std::filesystem::exists(fixture.GetRoot() / "scratch" / "finished.bin"));
+}
